{
    "name": "webview-example",
    "displayName": "Webview Example & EPUB Reader",
    "description": "A VS Code extension demonstrating Webview usage and reading EPUB e-books.",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.0.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "webviewExample.show",
                "title": "Show Webview Example"
            },
            {
                "command": "epubReader.open",
                "title": "Open EPUB Reader",
                "category": "EPUB"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "epubReader.open",
                    "when": "resourceExtname == .epub",
                    "group": "navigation"
                }
            ]
        }
    },
    "activationEvents": [
        "onCommand:epubReader.open"
    ],
    "dependencies": {
        "fast-xml-parser": "~5.8.0",
        "jszip": "^3.10.1"
    }
}
